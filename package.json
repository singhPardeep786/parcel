{
  "name": "parcel-reminder",
  "productName": "Parcel",
  "version": "1.0.3",
  "private": true,
  "author": {
    "name": "Grapes Worldwide"
  },
  "description": "Reminders for tasks and Google Calendar, with the Kratos frame animation. Installs on macOS, Windows, and Linux.",
  "homepage": "https://parcel-bj9e.vercel.app",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "npm run icon && electron .",
    "icon": "node scripts/make-icon.js",
    "test": "node --test electron/ics.test.js electron/schedule.test.js",
    "dist": "npm run icon && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "dist:mac": "npm run icon && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --x64 --arm64",
    "dist:win": "npm run icon && electron-builder --win nsis --x64 --arm64",
    "dist:linux": "npm run icon && electron-builder --linux AppImage --x64 --arm64",
    "dist:all": "npm run icon && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --win nsis --linux AppImage --x64 --arm64",
    "stage:update": "node scripts/stage-update.js",
    "release": "npm run dist:all && npm run stage:update"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "next": "^16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "sass": "^1.83.4"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.grapesworldwide.parcel",
    "productName": "Parcel",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "public/**/*",
      "package.json",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/sax/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/ms/**/*",
      "node_modules/tiny-typed-emitter/**/*"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://parcel-bj9e.vercel.app/"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null,
      "artifactName": "Parcel-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "forceCodeSigning": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Office",
      "artifactName": "Parcel-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "Grapes Worldwide"
    },
    "deb": {
      "compression": "gz"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Parcel",
      "artifactName": "Parcel-Setup-${version}-${arch}.${ext}"
    }
  }
}
